                           VerticalAlignment="Bottom" MarginLeft="118" MarginBottom="20" StackLayout.LayoutMethod="HorizontalCentered">
                  <ItemTemplate>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" SuggestedWidth="225"
                                  HeightSizePolicy="Fixed" SuggestedHeight="76" Brush="Header.Tab.Center"
                                  Command.Click="ExecuteSelect" IsSelected="@IsSelected" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.TabControl.Text" Brush.FontSize="15" Brush.TextHorizontalAlignment="Center"
                                    Brush.TextVerticalAlignment="Center" Text="@ButtonText"/>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
