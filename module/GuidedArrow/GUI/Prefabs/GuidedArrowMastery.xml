                            Brush="Clan.TabControl.Text" Brush.FontSize="23" Brush.FontColor="#82A947FF"
                            Brush.TextHorizontalAlignment="Center" Text="HUNTER'S MIND"/>
                <ListPanel DataSource="{HunterNodes}" WidthSizePolicy="Fixed" SuggestedWidth="175"
                           HeightSizePolicy="Fixed" SuggestedHeight="270" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" MarginBottom="0" StackLayout.LayoutMethod="VerticalBottomToTop">
                  <ItemTemplate>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" SuggestedWidth="175"
                                  HeightSizePolicy="Fixed" SuggestedHeight="48" MarginTop="4" Brush="Header.Tab.Center"
                                  Command.Click="ExecuteSelect" IsSelected="@IsSelected" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.TabControl.Text" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center"
                                    Brush.TextVerticalAlignment="Center" Text="@ButtonText"/>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>

                <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="220" HeightSizePolicy="Fixed" SuggestedHeight="30"
                            HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="120" MarginTop="18"
                            Brush="Clan.TabControl.Text" Brush.FontSize="20" Brush.FontColor="#5D91B5FF"
                            Brush.TextHorizontalAlignment="Center" Text="CONVERGENCE"/>
                <ListPanel DataSource="{NeedleNodes}" WidthSizePolicy="Fixed" SuggestedWidth="225"
