                           VerticalAlignment="Top" MarginLeft="118" MarginTop="52" StackLayout.LayoutMethod="HorizontalCentered">
                  <ItemTemplate>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" SuggestedWidth="225"
                                  HeightSizePolicy="Fixed" SuggestedHeight="76" Brush="Header.Tab.Center"
                                  Command.Click="ExecuteSelect" IsSelected="@IsSelected" UpdateChildrenStates="true">
                      <Children>
