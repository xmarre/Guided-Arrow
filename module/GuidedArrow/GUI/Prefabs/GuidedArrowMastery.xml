                            Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center"
                            Text="@SelectedRequirements"/>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="96"
                            Brush="Clan.TabControl.Text" Brush.FontSize="18" Brush.TextHorizontalAlignment="Center"
                            Brush.TextVerticalAlignment="Center" Text="@SelectedDescription"/>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="116"
