                <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="300" HeightSizePolicy="Fixed" SuggestedHeight="34"
                            HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="62"
                            Brush="Clan.TabControl.Text" Brush.FontSize="24" Brush.FontColor="#C47731FF"
                            Brush.TextHorizontalAlignment="Center" Text="PIERCING DOCTRINE"/>
                <ListPanel DataSource="{PiercingNodes}" WidthSizePolicy="Fixed" SuggestedWidth="175"
                           HeightSizePolicy="Fixed" SuggestedHeight="205" HorizontalAlignment="Center"
                           VerticalAlignment="Top" MarginTop="95" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <ItemTemplate>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" SuggestedWidth="175"
                                  HeightSizePolicy="Fixed" SuggestedHeight="58" MarginBottom="6" Brush="Header.Tab.Center"
                                  Command.Click="ExecuteSelect" IsSelected="@IsSelected" UpdateChildrenStates="true">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Clan.TabControl.Text" Brush.FontSize="15" Brush.TextHorizontalAlignment="Center"
                                    Brush.TextVerticalAlignment="Center" Text="@ButtonText"/>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>

                <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="430" HeightSizePolicy="Fixed" SuggestedHeight="34"
                            HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="4" MarginBottom="115"
                            Brush="Clan.TabControl.Text" Brush.FontSize="24" Brush.FontColor="#6BA7D9FF"
                            Brush.TextHorizontalAlignment="Center" Text="HAND OF THE ARCHER"/>
                <ListPanel DataSource="{HandNodes}" WidthSizePolicy="Fixed" SuggestedWidth="465"
                           HeightSizePolicy="Fixed" SuggestedHeight="74" HorizontalAlignment="Right"
